{
  "name": "lapis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "sh tools/blender/build.sh",
    "map": "node tools/map.ts",
    "check:core": "node tools/check-core.mjs",
    "probe:lighthouse": "node --experimental-transform-types --no-warnings --import ./tools/node/register.mjs tools/lighthouse-probe.ts",
    "playtest": "node --experimental-transform-types --no-warnings --import ./tools/node/register.mjs tools/playtest.ts"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
